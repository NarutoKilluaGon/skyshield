# SkyShield — environment
#
# Copy to `.env.local`. Defaults in `src/services/client.ts` keep the app
# running against the mock service layer, so this file is only needed when
# pointing at a real Django REST backend.

# Base URL for the DRF API, without a trailing slash.
VITE_API_BASE_URL=/api/v1

# Set to "false" to bypass the mock transport and issue real requests.
# When false, the app expects session/CSRF auth and these endpoints:
#   GET    /api/v1/incidents/?page=&page_size=&search=&severity=&status=…
#   GET    /api/v1/incidents/:id/
#   POST   /api/v1/incidents/
#   PATCH  /api/v1/incidents/:id/
#   GET    /api/v1/dashboard/metrics/
#   GET    /api/v1/investigations/
#   GET    /api/v1/rca/
#   GET    /api/v1/capa/
#   GET    /api/v1/compliance/requirements/
#   GET    /api/v1/notifications/
#   GET    /api/v1/audit-log/
VITE_USE_MOCK=true

# ── Django API (backend/) ─────────────────────────────────────────────
# Vite proxies /api here in `dev` and `preview` (default http://127.0.0.1:8000).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# The backend itself reads SKYSHIELD_* from the process environment of the
# shell running manage.py — not from this file. Full list in docs/DEPLOY.md:
#   SKYSHIELD_SECRET_KEY      signing key for sessions/CSRF (always set in prod)
#   SKYSHIELD_DEMO_MODE       false in prod: no reset tokens in responses,
#                             unknown invite tokens rejected (default true)
#   SKYSHIELD_CSRF_ORIGINS    comma list of SPA origins trusted through the proxy
#   SKYSHIELD_DB              SQLite path (default backend/db.sqlite3)
#   SKYSHIELD_ANON_WINDOW / SKYSHIELD_ANON_DAILY_MAX
#                             anonymous-intake throttle (120 s / 10 per IP)
#   SKYSHIELD_THROTTLE_USER / _ANON / _LOGIN   DRF rates (600/min, 60/min, 30/min)
